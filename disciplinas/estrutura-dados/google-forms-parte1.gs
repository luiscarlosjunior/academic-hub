/**
 * Google Form em modo quiz: parte 1 de 3
 * Questões 1 a 10 de 30 do banco de C básica, ponteiros, vetores e matrizes.
 * O enunciado de cada questão é uma imagem; as alternativas são de múltipla escolha,
 * com a resposta correta marcada.
 *
 * Como usar: no Google Drive, crie um Apps Script novo (script.new), cole este código,
 * salve e execute criarQuiz uma vez. Os links aparecem em Ver > Registros.
 */

const QUESTOES = [{"n": 1, "tema": "C básica", "imagem_b64": "", "opcoes": ["8", "40", "10", "4", "80"], "correta": "B"}, {"n": 2, "tema": "C básica", "imagem_b64": "", "opcoes": ["6 e 6", "4 e 5", "5 e 5", "6 e 5", "5 e 6"], "correta": "E"}, {"n": 3, "tema": "C básica", "imagem_b64": "", "opcoes": ["Erro de compilação", "0", "Um valor de lixo de memória", "10", "3"], "correta": "E"}, {"n": 4, "tema": "C básica", "imagem_b64": "", "opcoes": ["i = 3, j = 6", "i = 3, j = 8", "i = 2, j = 6", "i = 3, j = 9", "i = 2, j = 9"], "correta": "A"}, {"n": 5, "tema": "C básica", "imagem_b64": "", "opcoes": ["O compilador sempre bloqueia o acesso e exibe uma mensagem de erro", "É comportamento indefinido: o programa pode travar, produzir lixo ou corromper outra variável, sem aviso.", "O valor devolvido é sempre zero, pois C preenche a memória com zeros", "O índice é automaticamente reduzido ao último elemento válido", "A linguagem lança uma exceção que pode ser capturada com try/catch"], "correta": "B"}, {"n": 6, "tema": "C básica", "imagem_b64": "", "opcoes": ["Multiplicar p por zero antes de reutilizá-lo", "Confiar que free zera o ponteiro automaticamente", "Atribuir NULL a p, para que qualquer uso posterior seja detectado com um teste explícito.", "Chamar free(p) de novo para garantir que a memória foi liberada", "Deixar p como está, pois o sistema impede acessos a memória liberada"], "correta": "C"}, {"n": 7, "tema": "Ponteiros", "imagem_b64": "", "opcoes": ["5", "Erro de compilação", "&x", "O endereço de x", "9"], "correta": "E"}, {"n": 8, "tema": "Ponteiros", "imagem_b64": "", "opcoes": ["20 20", "10 30", "20 30", "30 50", "20 40"], "correta": "E"}, {"n": 9, "tema": "Ponteiros", "imagem_b64": "", "opcoes": ["*(&v + i)", "*v + i", "*(v + i)", "v + i", "&v[i] + 1"], "correta": "C"}, {"n": 10, "tema": "Ponteiros", "imagem_b64": "", "opcoes": ["Porque sizeof não funciona com arrays de inteiros", "Porque sizeof só mede variáveis globais", "Porque o parâmetro é recebido como um ponteiro, e a informação sobre o tamanho do array não chega à função.", "Porque a função sempre recebe um vetor de um único elemento", "Porque o vetor é copiado inteiro e fica com tamanho zero"], "correta": "C"}];

function criarQuiz() {
  const form = FormApp.create('Banco de questões (parte 1 de 3): C, ponteiros, vetores e matrizes');
  form.setDescription(
    'Estrutura de Dados. Parte 1 de 3 (questões 1 a 10). ' +
    'Múltipla escolha, cinco alternativas cada, uma correta. Cada questão vale 1 ponto.'
  );
  form.setIsQuiz(true);
  form.setCollectEmail(false);
  form.setShowLinkToRespondAgain(false);
  form.setAllowResponseEdits(false);
  form.setLimitOneResponsePerUser(true);
  form.setPublishingSummary(false);
  form.setConfirmationMessage('Respostas enviadas. Obrigado!');
  form.setProgressBar(true);

  const letras = ['A', 'B', 'C', 'D', 'E'];

  QUESTOES.forEach(function (q) {
    const itemImagem = form.addImageItem();
    itemImagem.setTitle('Enunciado da questão ' + String(q.n).padStart(2, '0'));
    itemImagem.setImage(imagemDoBase64(q.imagem_b64, 'questao' + q.n));

    const item = form.addMultipleChoiceItem();
    item.setTitle('Questão ' + String(q.n).padStart(2, '0') + ': qual é a alternativa correta?');
    item.setPoints(1);
    item.setRequired(true);

    const escolhas = q.opcoes.map(function (texto, i) {
      return item.createChoice(letras[i] + ') ' + texto, letras[i] === q.correta);
    });
    item.setChoices(escolhas);
  });

  Logger.log('Formulário criado: ' + form.getEditUrl());
  Logger.log('Link para responder: ' + form.getPublishedUrl());
  return form.getPublishedUrl();
}

function imagemDoBase64(texto, nome) {
  if (typeof texto !== 'string' || texto.length === 0) {
    throw new Error('Imagem ausente: ' + nome);
  }
  return Utilities.newBlob(Utilities.base64Decode(texto), 'image/jpeg', nome + '.jpg');
}
