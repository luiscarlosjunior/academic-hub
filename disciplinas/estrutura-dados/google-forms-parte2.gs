/**
 * Google Form em modo quiz: parte 2 de 3
 * Questões 11 a 20 de 30 do banco de C básica, ponteiros, vetores e matrizes.
 * O enunciado de cada questão é uma imagem; as alternativas são de múltipla escolha,
 * com a resposta correta marcada.
 *
 * Como usar: no Google Drive, crie um Apps Script novo (script.new), cole este código,
 * salve e execute criarQuiz uma vez. Os links aparecem em Ver > Registros.
 */

const QUESTOES = [{"n": 11, "tema": "Ponteiros", "imagem_b64": "", "opcoes": ["Verificar se v->dados é NULL antes de chamar realloc", "Guardar o retorno em um ponteiro temporário e só atribuir a v->dados se o valor não for NULL.", "Trocar realloc por calloc, que nunca falha", "Chamar free(v->dados) antes de realloc, para liberar espaço", "Atribuir o retorno diretamente a v->dados, pois realloc libera o bloco antigo antes de falhar"], "correta": "B"}, {"n": 12, "tema": "Ponteiros", "imagem_b64": "", "opcoes": ["p pode apontar para outro endereço, mas o valor apontado não pode ser alterado através de p.", "A variável x apontada por p torna-se constante em todo o programa", "É equivalente a int * const p", "p não pode mudar de endereço, mas o valor apontado pode ser alterado", "Nem p nem o valor apontado podem ser alterados"], "correta": "A"}, {"n": 13, "tema": "Ponteiros", "imagem_b64": "", "opcoes": ["O valor 5 é gravado no endereço zero, sem efeito colateral", "A atribuição é ignorada silenciosamente pelo compilador", "p passa a apontar para o endereço 5", "O compilador recusa o código por incompatibilidade de tipos", "É comportamento indefinido, geralmente com falha de segmentação. O correto é testar p != NULL antes de desreferenciar."], "correta": "E"}, {"n": 14, "tema": "Ponteiros", "imagem_b64": "", "opcoes": ["Acesso a uma cópia da struct, que não altera o original", "Erro de sintaxe, pois ponteiros para struct não usam ponto nem seta", "Multiplicação entre o campo d e o ponteiro m", "Acesso ao campo da struct apontada por m; é equivalente a (*m).campo.", "Acesso ao endereço da struct, não ao campo"], "correta": "D"}, {"n": 15, "tema": "Ponteiros", "imagem_b64": "", "opcoes": ["O endereço do segundo elemento, em hexadecimal", "3", "2", "0", "1"], "correta": "C"}, {"n": 16, "tema": "Vetores", "imagem_b64": "", "opcoes": ["Porque o vetor é mantido ordenado internamente pela linguagem", "Porque C guarda um índice separado para cada elemento", "Porque C utiliza uma tabela hash para cada vetor", "Porque o endereço é calculado diretamente: endereço base + i × tamanho do elemento, sem percorrer nada.", "Porque o processador examina todos os elementos em paralelo"], "correta": "D"}, {"n": 17, "tema": "Vetores", "imagem_b64": "", "opcoes": ["O vetor deve estar ordenado.", "O vetor deve ter tamanho igual a uma potência de 2", "O vetor não pode conter valores repetidos", "O vetor deve estar armazenado em uma lista encadeada", "O vetor deve ter pelo menos mil elementos"], "correta": "A"}, {"n": 18, "tema": "Vetores", "imagem_b64": "", "opcoes": ["3", "9", "2", "1", "4"], "correta": "A"}, {"n": 19, "tema": "Vetores", "imagem_b64": "", "opcoes": ["O(n²), pois cada deslocamento exige uma nova cópia do vetor", "O(1), pois basta trocar o primeiro elemento com o último", "O(log n), pela busca binária da posição", "O(1), pois a remoção apenas diminui o tamanho do vetor", "O(n), pois todos os elementos seguintes precisam ser deslocados uma posição para a esquerda."], "correta": "E"}, {"n": 20, "tema": "Vetores", "imagem_b64": "", "opcoes": ["4: 1 2 2 3", "3: 1 2 3", "3: 1 1 2", "6: 1 1 2 2 2 3", "2: 1 2"], "correta": "B"}];

function criarQuiz() {
  const form = FormApp.create('Banco de questões (parte 2 de 3): C, ponteiros, vetores e matrizes');
  form.setDescription(
    'Estrutura de Dados. Parte 2 de 3 (questões 11 a 20). ' +
    'Múltipla escolha, cinco alternativas cada, uma correta. Cada questão vale 1 ponto.'
  );
  form.setIsQuiz(true);
  form.setCollectEmail(false);
  form.setShowLinkToRespondAgain(false);
  form.setAllowResponseEdits(false);
  form.setLimitOneResponsePerUser(true);
  form.setPublishingSummary(false);
  form.setConfirmationMessage('Respostas enviadas. Obrigado!');
  form.setProgressBar(true);

  const letras = ['A', 'B', 'C', 'D', 'E'];

  QUESTOES.forEach(function (q) {
    const itemImagem = form.addImageItem();
    itemImagem.setTitle('Enunciado da questão ' + String(q.n).padStart(2, '0'));
    itemImagem.setImage(imagemDoBase64(q.imagem_b64, 'questao' + q.n));

    const item = form.addMultipleChoiceItem();
    item.setTitle('Questão ' + String(q.n).padStart(2, '0') + ': qual é a alternativa correta?');
    item.setPoints(1);
    item.setRequired(true);

    const escolhas = q.opcoes.map(function (texto, i) {
      return item.createChoice(letras[i] + ') ' + texto, letras[i] === q.correta);
    });
    item.setChoices(escolhas);
  });

  Logger.log('Formulário criado: ' + form.getEditUrl());
  Logger.log('Link para responder: ' + form.getPublishedUrl());
  return form.getPublishedUrl();
}

function imagemDoBase64(texto, nome) {
  if (typeof texto !== 'string' || texto.length === 0) {
    throw new Error('Imagem ausente: ' + nome);
  }
  return Utilities.newBlob(Utilities.base64Decode(texto), 'image/jpeg', nome + '.jpg');
}
