/**
 * Google Form em modo quiz: parte 3 de 3
 * Questões 21 a 30 de 30 do banco de C básica, ponteiros, vetores e matrizes.
 * O enunciado de cada questão é uma imagem; as alternativas são de múltipla escolha,
 * com a resposta correta marcada.
 *
 * Como usar: no Google Drive, crie um Apps Script novo (script.new), cole este código,
 * salve e execute criarQuiz uma vez. Os links aparecem em Ver > Registros.
 */

const QUESTOES = [{"n": 21, "tema": "Vetores", "imagem_b64": "", "opcoes": ["Para restaurar o tamanho original do vetor após as trocas", "Porque inverter faixas não altera a posição dos elementos", "Porque cada bloco fica na ordem invertida após as duas primeiras; a inversão final restaura a ordem de cada bloco e coloca o bloco [k,n) no início.", "Para impedir que k seja maior que n", "Porque sem ela o vetor fica em ordem decrescente"], "correta": "C"}, {"n": 22, "tema": "Vetores", "imagem_b64": "", "opcoes": ["6", "4", "7", "-1", "8"], "correta": "A"}, {"n": 23, "tema": "Vetores", "imagem_b64": "", "opcoes": ["O(n log n)", "O(log n)", "O(n²)", "O(n)", "O(1)"], "correta": "D"}, {"n": 24, "tema": "Matrizes", "imagem_b64": "", "opcoes": ["11", "8", "9", "6", "7"], "correta": "C"}, {"n": 25, "tema": "Matrizes", "imagem_b64": "", "opcoes": ["Porque a matriz é armazenada coluna por coluna em C", "Porque as linhas estão armazenadas de forma contígua, então os acessos consecutivos aproveitam o cache.", "Porque percorrer colunas usa mais memória de pilha", "Porque o percurso por colunas ignora o último elemento", "Porque o compilador só otimiza laços que percorrem linhas"], "correta": "B"}, {"n": 26, "tema": "Matrizes", "imagem_b64": "", "opcoes": ["10 linhas por 1 coluna", "5 linhas por 5 colunas", "2 linhas por 5 colunas", "5 linhas por 2 colunas", "2 linhas por 2 colunas"], "correta": "D"}, {"n": 27, "tema": "Matrizes", "imagem_b64": "", "opcoes": ["calloc zera toda a memória alocada, então a matriz começa com zeros sem um laço de inicialização.", "calloc aceita tamanhos maiores que malloc, sem limite", "calloc é sempre mais rápido do que malloc, em qualquer caso", "malloc não permite liberar a memória depois com free", "calloc cria automaticamente uma matriz de ponteiros"], "correta": "A"}, {"n": 28, "tema": "Matrizes", "imagem_b64": "", "opcoes": ["9 8 7 6 5 4 3 2 1", "1 2 3 6 9 8 7 5 4", "1 2 3 4 5 6 7 8 9", "1 2 3 6 9 8 7 4 5", "1 4 7 8 9 6 3 2 5"], "correta": "D"}, {"n": 29, "tema": "Matrizes", "imagem_b64": "", "opcoes": ["8", "12", "4", "6", "9"], "correta": "B"}, {"n": 30, "tema": "Matrizes", "imagem_b64": "", "opcoes": ["24", "16", "36", "48", "12"], "correta": "D"}];

function criarQuiz() {
  const form = FormApp.create('Banco de questões (parte 3 de 3): C, ponteiros, vetores e matrizes');
  form.setDescription(
    'Estrutura de Dados. Parte 3 de 3 (questões 21 a 30). ' +
    'Múltipla escolha, cinco alternativas cada, uma correta. Cada questão vale 1 ponto.'
  );
  form.setIsQuiz(true);
  form.setCollectEmail(false);
  form.setShowLinkToRespondAgain(false);
  form.setAllowResponseEdits(false);
  form.setLimitOneResponsePerUser(true);
  form.setPublishingSummary(false);
  form.setConfirmationMessage('Respostas enviadas. Obrigado!');
  form.setProgressBar(true);

  const letras = ['A', 'B', 'C', 'D', 'E'];

  QUESTOES.forEach(function (q) {
    const itemImagem = form.addImageItem();
    itemImagem.setTitle('Enunciado da questão ' + String(q.n).padStart(2, '0'));
    itemImagem.setImage(imagemDoBase64(q.imagem_b64, 'questao' + q.n));

    const item = form.addMultipleChoiceItem();
    item.setTitle('Questão ' + String(q.n).padStart(2, '0') + ': qual é a alternativa correta?');
    item.setPoints(1);
    item.setRequired(true);

    const escolhas = q.opcoes.map(function (texto, i) {
      return item.createChoice(letras[i] + ') ' + texto, letras[i] === q.correta);
    });
    item.setChoices(escolhas);
  });

  Logger.log('Formulário criado: ' + form.getEditUrl());
  Logger.log('Link para responder: ' + form.getPublishedUrl());
  return form.getPublishedUrl();
}

function imagemDoBase64(texto, nome) {
  if (typeof texto !== 'string' || texto.length === 0) {
    throw new Error('Imagem ausente: ' + nome);
  }
  return Utilities.newBlob(Utilities.base64Decode(texto), 'image/jpeg', nome + '.jpg');
}
