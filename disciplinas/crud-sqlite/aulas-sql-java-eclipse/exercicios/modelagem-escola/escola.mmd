%% Modelo entidade-relacionamento: escola de idiomas (parte A)
erDiagram
    ALUNO ||--o{ MATRICULA : "faz"
    CURSO ||--o{ MATRICULA : "recebe"

    ALUNO {
        int id PK
        string nome
        string email UK
        string cidade
    }

    CURSO {
        int id PK
        string idioma
        string nivel
        float mensalidade
    }

    MATRICULA {
        int id PK
        int aluno_id FK
        int curso_id FK
        string data
        float nota
    }
